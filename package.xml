<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">

  <!--[ Info ]-->

  <name>Selection interface for LLM</name>
  <description>Steps through the real computation order of a PartDesign document: shows one feature at a time, datum planes and the driving sketch included, without modifying the document; keeps the viewing angle and exports the build-up as a GIF; and copies a ready-to-use description of one feature to the clipboard for an LLM.</description>
  <version>2.1.0</version>
  <date>2026-11-08</date>

  <!--[ Ecosystem requirements ]-->

  <freecadmin>1.1.0</freecadmin>
  <pythonmin>3.10</pythonmin>

  <!--[ Tags ]-->

  <tag>PartDesign</tag>
  <tag>Animation</tag>
  <tag>Documentation</tag>
  <tag>LLM</tag>

